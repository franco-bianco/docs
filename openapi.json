              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Server-generated correlation identifier; caller-supplied identifiers are ignored."
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Seconds before retrying."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server failure.",
