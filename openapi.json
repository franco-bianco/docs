                }
              }
            }
          },
          "503": {
            "description": "The service cannot accept jobs: SANDBOX_DISABLED when it is not set up to run jobs, or SHUTTING_DOWN while it restarts. Retry SHUTTING_DOWN after a short wait.",
            "headers": {
              "X-Request-Id": {
