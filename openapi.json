    "/v1/jobs/{id}": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "operationId": "getJob",
        "summary": "Get a job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "wait",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^([0-9]|[12][0-9]|30)$"
            },
            "description": "Seconds (0 to 30; more is a 400) to hold the request open while the job has not finished; the job as it is then."
          }
        ],
        "responses": {
          "200": {
            "description": "The job and, once finished, its token or error.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Server-generated correlation identifier; caller-supplied identifiers are ignored."
