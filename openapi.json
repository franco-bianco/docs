                ],
                "format": "date-time",
                "description": "When the token stops being accepted: the validity the response gave, counted from the job start, so never later than the real moment."
              },
              "userAgent": {
                "type": "string",
                "description": "The user agent the token was made as: send it in each request to the site."
              },
              "acceptLanguage": {
                "type": "string",
                "description": "The Accept-Language the token was made with."
              },
              "secUa": {
                "type": "string",
                "description": "The sec-ch-ua header the token was made with; absent for a device that sends no client hints."
              },
              "secUaMobile": {
                "type": "string",
                "description": "The sec-ch-ua-mobile header; absent with secUa."
              },
              "secUaPlatform": {
                "type": "string",
                "description": "The sec-ch-ua-platform header; absent with secUa."
              }
            },
            "required": [
