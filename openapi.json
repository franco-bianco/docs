      "delete": {
        "tags": [
          "Jobs"
        ],
        "operationId": "cancelJob",
        "summary": "Cancel a job",
        "description": "A queued job leaves the line and a running one is stopped; both then read as failed with JOB_CANCELLED. A finished job is removed from the server.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The job as it was left.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Server-generated correlation identifier; caller-supplied identifiers are ignored."
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Server-generated correlation identifier; caller-supplied identifiers are ignored."
                    },
                    "data": {
                      "$ref": "#/components/schemas/Job"
                    }
                  },
                  "required": [
                    "ok",
                    "requestId",
                    "data"
                  ],
                  "additionalProperties": false
                },
                "examples": {
                  "cancelled": {
                    "value": {
