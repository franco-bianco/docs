            ],
            "additionalProperties": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "A stable code: JOB_CANCELLED, JOB_TIMEOUT or SHUTTING_DOWN from the queue, else the code of the run that failed, such as SANDBOX_SOLVE_FAILED, UPSTREAM_TIMEOUT or PROTOCOL_EXECUTION_FAILED."
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "url",
          "siteKey",
          "action",
          "status",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "Server-generated correlation identifier; caller-supplied identifiers are ignored."
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable machine-readable error code."
              },
              "message": {
                "type": "string",
                "description": "Human-readable explanation without credentials."
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "requestId",
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
