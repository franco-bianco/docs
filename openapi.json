{
  "openapi": "3.1.0",
  "info": {
    "title": "bapsolver API",
    "version": "0.2.0",
    "description": "Submit a token job for a page and its public reCAPTCHA v3 site key, then poll the job for the token."
  },
  "servers": [
    {
      "url": "https://api.bapsolver.xyz",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Jobs",
      "description": "Create, read, list and cancel token jobs."
    },
    {
      "name": "Service",
      "description": "Service health."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Service"
        ],
        "operationId": "getHealth",
        "summary": "Check service health",
        "security": [],
        "responses": {
          "200": {
            "description": "Service status.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Server-generated correlation identifier; caller-supplied identifiers are ignored."
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Server-generated correlation identifier; caller-supplied identifiers are ignored."
                    },
                    "data": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "ok",
                    "requestId",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "description": "Public and unauthenticated. Returns `ok: true` while the service is up. A healthy service can still fail a job."
      }
    },
    "/v1/jobs": {
      "post": {
        "tags": [
          "Jobs"
        ],
        "operationId": "createJob",
        "summary": "Create a job",
        "description": "Returns at once with `202 Accepted` and the job in the `queued` state. The `Location` header holds the job path. Read the job with Get a job until it is `done` or `failed`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The job was queued.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Server-generated correlation identifier; caller-supplied identifiers are ignored."
                }
              },
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Server-generated correlation identifier; caller-supplied identifiers are ignored."
                    },
                    "data": {
                      "$ref": "#/components/schemas/Job"
                    }
                  },
                  "required": [
                    "ok",
                    "requestId",
                    "data"
                  ],
                  "additionalProperties": false
                },
                "examples": {
                  "queued": {
                    "value": {
                      "ok": true,
                      "requestId": "0f6c1d2e-8a4b-4c3d-9e1f-2a3b4c5d6e7f",
                      "data": {
                        "id": "3b1f7c9a-2d4e-4f6a-8b0c-1d2e3f4a5b6c",
                        "kind": "recap_v3",
                        "url": "https://www.example.com/login",
                        "siteKey": "YOUR_SITE_KEY",
                        "action": "login",
                        "status": "queued",
                        "createdAt": "2026-10-25T09:30:00.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request: an unknown field or kind, a wrong type, a proxy on a kind that takes none or missing on one that needs it, a bad URL or action.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Server-generated correlation identifier; caller-supplied identifiers are ignored."
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer credentials are missing or invalid.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Server-generated correlation identifier; caller-supplied identifiers are ignored."
                }
              },
              "WWW-Authenticate": {
                "schema": {
                  "const": "Bearer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "The JSON request body exceeds 1 MiB.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Server-generated correlation identifier; caller-supplied identifiers are ignored."
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "The request rate or the job queue limit was reached.",
