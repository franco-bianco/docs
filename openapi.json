  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your API token. Send it on every /v1 request as `Authorization: Bearer <API_TOKEN>`."
      }
    },
    "schemas": {
      "JobRequest": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "recap_v3",
              "recap_v3_enterprise",
              "recap_v3_proxy",
              "recap_v3_enterprise_proxy"
            ],
            "description": "recap_v3: reCAPTCHA v3. recap_v3_enterprise: reCAPTCHA Enterprise. The _proxy kinds run through the proxy sent with the job; the others take none."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 4096,
            "description": "The page the challenge is on; the token is for its origin."
          },
          "siteKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "action": {
            "type": "string",
            "pattern": "^[A-Za-z0-9/_]+$",
            "minLength": 1,
            "maxLength": 100,
            "default": "submit",
            "description": "The reCAPTCHA v3 action."
          },
          "proxy": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512,
            "description": "Proxy for the _proxy kinds: a pool id or IP:PORT:USER:PASS. Credentials are never echoed back."
          }
        },
        "required": [
          "kind",
          "url",
          "siteKey"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "kind": "recap_v3",
            "url": "https://example.com/login",
            "siteKey": "6Lc...",
            "action": "login"
          },
          {
            "kind": "recap_v3_enterprise_proxy",
            "url": "https://example.com/",
            "siteKey": "6Lc...",
            "proxy": "203.0.113.7:8080:user:pass"
          }
        ]
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "recap_v3",
              "recap_v3_enterprise",
              "recap_v3_proxy",
              "recap_v3_enterprise_proxy"
            ]
          },
          "url": {
            "type": "string"
          },
          "siteKey": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "done",
              "failed"
            ],
            "description": "Poll until done or failed (GET with ?wait=N holds the request until then). A token is good for about two minutes."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "maxLength": 32768
              },
              "expiresAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "When the token stops being accepted: the validity the response gave, counted from the job start, so never later than the real moment."
              },
              "userAgent": {
                "type": "string",
                "description": "The user agent the token was made as: send it in each request to the site."
              },
              "acceptLanguage": {
                "type": "string",
                "description": "The Accept-Language the token was made with."
              },
              "secUa": {
                "type": "string",
                "description": "The sec-ch-ua header the token was made with; absent for a device that sends no client hints."
              },
              "secUaMobile": {
                "type": "string",
                "description": "The sec-ch-ua-mobile header; absent with secUa."
              },
              "secUaPlatform": {
                "type": "string",
                "description": "The sec-ch-ua-platform header; absent with secUa."
              }
            },
            "required": [
              "token",
              "expiresAt",
              "userAgent",
              "acceptLanguage"
            ],
            "additionalProperties": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "A stable code: JOB_CANCELLED, JOB_TIMEOUT or SHUTTING_DOWN from the queue, else the code of the run that failed, such as SANDBOX_SOLVE_FAILED, UPSTREAM_TIMEOUT or PROTOCOL_EXECUTION_FAILED."
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "url",
          "siteKey",
          "action",
          "status",
          "createdAt"
        ],
        "additionalProperties": false
      },
